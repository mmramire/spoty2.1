{
  "name": "spoty2",
  "version": "1.0.0",
  "description": "CLI para autenticación con Spotify usando OAuth 2.0 PKCE",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "spoty": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && tsc-alias",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check --write .",
    "lint:check": "biome check ."
  },
  "keywords": [
    "spotify",
    "oauth",
    "cli",
    "pkce"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@spotify/web-api-ts-sdk": "^1.2.0",
    "open": "^11.0.4",
    "pino": "^9.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "msw": "^2.3.0",
    "pino-pretty": "^13.1.3",
    "tsc-alias": "^1.9.7",
    "typescript": "^5.5.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "allowScripts": {
    "@biomejs/biome@1.9.4": true,
    "esbuild@0.21.5": true,
    "msw@2.15.0": true
  }
}
